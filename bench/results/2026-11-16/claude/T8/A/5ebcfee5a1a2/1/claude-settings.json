{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "mcp__agent-code-mode__run"
    ]
  },
  "autoMemoryEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<repo>/bench/hooks/protect-file.mjs\" \"src/handlers/inventory.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
